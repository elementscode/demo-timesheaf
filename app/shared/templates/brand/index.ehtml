import "./style.css";

<Brand (href: string = "/")>
  <a class="brand row" href={href}>
    <svg class="brand-mark" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect width="24" height="24" rx="6" fill="currentColor"/>
      <path d="M12 5.5v13M8 7.5l4 4 4-4M7.5 12l4.5 4.5 4.5-4.5" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
    <span>timesheaf</span>
  </a>
</Brand>
